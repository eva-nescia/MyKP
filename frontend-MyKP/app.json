{
  "expo": {
    "name": "frontend-MyKP",
    "slug": "frontend-MyKP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/MyKP_logo.png",
    "scheme": "frontendmykp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.keaneken.frontendmykp"
    },
    "android": {
      "package": "com.keaneken.frontendmykp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/MyKP_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.193433707669-jm6q5stj4jjr940c46lkv8a4vefi1hgv"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "extra": {
      "googleWebClientId": "193433707669-v82q01sn5t3fqtbec7qu08afi0dcrukj.apps.googleusercontent.com",
      "googleAndroidClientId": "193433707669-vk5lej74bdh0kjhfrifm7cjajch8is5l.apps.googleusercontent.com",
      "googleIosClientId": "193433707669-jm6q5stj4jjr940c46lkv8a4vefi1hgv.apps.googleusercontent.com",
      "googleAuthProxyRedirectUri": "https://auth.expo.io/@KeaneKen/frontend-MyKP",
      "apiBaseUrl": "auto",
      "apiPort": "8000",
      "router": {},
      "eas": {
        "projectId": "95df7b98-695d-46db-ad4f-2d2274d7c2e0"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
